generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ConversationType {
  CHANNEL
  DM
}

enum AttachmentStatus {
  PENDING_UPLOAD
  SCANNING
  CLEAN
  INFECTED
  FAILED
}

enum LinkPreviewStatus {
  PENDING
  OK
  FAILED
}

// `name` in Better Auth is mapped to `displayName` (see src/lib/auth.ts).
model User {
  id                  String               @id @default(cuid())
  displayName         String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  avatarColor         String               @default("#6D5EF6")
  // Custom status; null statusExpiresAt means "don't clear". Expired statuses are ignored, not deleted.
  statusEmoji         String?
  statusText          String?
  statusExpiresAt     DateTime?
  // Do Not Disturb; null dndUntil means "until turned off".
  dnd                 Boolean              @default(false)
  dndUntil            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  workspaceLinks      WorkspaceMember[]
  memberships         ConversationMember[]
  messages            Message[]
  reactions           Reaction[]
  readCursors         ReadCursor[]
  sessions            Session[]
  accounts            Account[]
  attachments         Attachment[]
  pinnedConversations PinnedConversation[]
  drafts              Draft[]
  reminders           Reminder[]
  pollVotes           PollVote[]
}

// Better Auth tables.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  createdAt     DateTime          @default(now())
  members       WorkspaceMember[]
  conversations Conversation[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
}

// Channel names are stored normalized (lowercase). A DM's name is its sorted member ids joined by ":",
// so the unique constraint also guarantees one DM per pair of people.
// Membership of a public channel only decides whose sidebar shows it: any workspace member can read one.
// An archived channel keeps its history and members but is read-only (see src/lib/access.ts).
model Conversation {
  id          String               @id @default(cuid())
  workspaceId String
  name        String
  type        ConversationType     @default(CHANNEL)
  isPrivate   Boolean              @default(false)
  topic       String?
  description String?
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime             @default(now())
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]
  readCursors ReadCursor[]
  attachments Attachment[]
  pinnedBy    PinnedConversation[]
  drafts      Draft[]
  reminders   Reminder[]

  @@unique([workspaceId, type, name])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model Message {
  id              String                   @id @default(cuid())
  conversationId  String
  authorId        String
  clientMessageId String
  body            String
  // Thread replies point at their top-level parent; threads are one level deep.
  parentId        String?
  replyCount      Int                      @default(0)
  // A forwarded (shared) message shows the original as a quoted card. The body is the forwarder's own comment.
  forwardedFromId String?
  lastReplyAt     DateTime?
  createdAt       DateTime                 @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  // Generated column (see the add_features migration): to_tsvector('english', body).
  searchVector    Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, body)"))
  conversation    Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent          Message?                 @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Message[]                @relation("Thread")
  forwardedFrom   Message?                 @relation("Forward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        Message[]                @relation("Forward")
  reactions       Reaction[]
  attachments     Attachment[]
  links           MessageLink[]
  poll            Poll?

  @@unique([authorId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([parentId, createdAt, id])
  @@index([forwardedFromId])
  @@index([authorId, createdAt])
  @@index([searchVector], type: Gin)
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model ReadCursor {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

// Uploaded straight to private object storage with a presigned URL, then scanned before anyone can download it.
model Attachment {
  id             String           @id @default(cuid())
  conversationId String
  uploaderId     String
  messageId      String?
  storageKey     String           @unique
  fileName       String
  contentType    String
  size           Int
  status         AttachmentStatus @default(PENDING_UPLOAD)
  createdAt      DateTime         @default(now())
  scannedAt      DateTime?
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploader       User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([uploaderId, status])
}

// A channel or DM the user pinned to the top of their sidebar. Personal: nobody else sees it.
// Not tied to membership, because public channels can be seen (and pinned) without joining.
model PinnedConversation {
  userId         String
  conversationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

// Unsent composer text for one conversation, so it survives switching channels, reloads and devices.
// Personal, like pins. The body keeps mentions as <@id> tokens. An empty draft is deleted, not stored.
model Draft {
  userId         String
  conversationId String
  body           String
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

// A reminder someone set for themselves with /remind. The reminder clock (src/lib/reminders.ts) sets firedAt
// when remindAt passes; it stays until marked done (deleted) or snoozed (new remindAt, firedAt cleared).
model Reminder {
  id             String        @id @default(cuid())
  userId         String
  // Where it was set, so the reminder can link back. Cleared if the conversation is deleted.
  conversationId String?
  text           String
  remindAt       DateTime
  firedAt        DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([firedAt, remindAt])
  @@index([userId, firedAt])
  @@index([conversationId])
}

// Open Graph data for a URL, shared by every message that links to it. This table is the unfurl cache:
// src/lib/unfurl.ts refetches a row once it is older than its TTL. Rows are created PENDING with the message.
model LinkPreview {
  url         String            @id
  status      LinkPreviewStatus @default(PENDING)
  title       String?
  description String?
  siteName    String?
  imageUrl    String?
  fetchedAt   DateTime?
  messages    MessageLink[]
}

// The URLs found in a message body, in order (at most MAX_LINKS_PER_MESSAGE).
model MessageLink {
  messageId String
  position  Int
  url       String
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  preview   LinkPreview @relation(fields: [url], references: [url], onDelete: Cascade)

  @@id([messageId, position])
  @@index([url])
}

// Transactional outbox: written in the same transaction as the change it describes, then delivered by
// src/lib/outbox-worker.ts with retries. `availableAt` doubles as the lease while a worker holds the event.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  failedAt    DateTime?
  lastError   String?

  @@index([failedAt, availableAt, id])
}

// A poll is attached to an ordinary message, whose body is the question (so search and previews work as they
// do for text). Options cannot change once the poll exists.
model Poll {
  id          String       @id @default(cuid())
  messageId   String       @unique
  multiSelect Boolean      @default(false)
  // Votes are still stored per user (one vote per option each), but voter ids are never sent to clients.
  anonymous   Boolean      @default(false)
  closesAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       PollVote[]

  @@index([closedAt, closesAt])
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  position Int
  label    String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@unique([pollId, position])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
}
