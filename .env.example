# Local Docker Compose defaults
DATABASE_URL="postgresql://chat:chat@localhost:5432/chat?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_NAME="Orbit Chat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# Sign-ups join this workspace (created on first sign-up if it does not exist).
DEFAULT_WORKSPACE_SLUG="acme"

# Private attachment storage (SeaweedFS from docker-compose). S3_PUBLIC_ENDPOINT is what browsers use for
# presigned URLs; set it when the server reaches storage on a different hostname than browsers do.
S3_ENDPOINT="http://localhost:8333"
S3_PUBLIC_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_BUCKET="orbit-chat-attachments"
S3_ACCESS_KEY_ID="orbit-dev"
S3_SECRET_ACCESS_KEY="orbit-dev-secret"

# Malware scanning: "clamav" (default) or "disabled" (development only; refused when NODE_ENV=production).
MALWARE_SCANNER="clamav"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
